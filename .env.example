# Copy to `.env` and fill in the provider(s) you plan to use.
# Only the key for your selected --provider is required.

# Anthropic Claude (default provider)
ANTHROPIC_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# Local / self-hosted OpenAI-compatible server (e.g. Ollama, LM Studio, vLLM)
LOCAL_AI_BASE_URL=http://localhost:11434/v1
LOCAL_AI_MODEL=llama3.1
# LOCAL_AI_API_KEY=            # optional; many local servers are keyless
# LOCAL_AI_JSON_MODE=true      # set false if the server rejects response_format

# Override how the Better-T-Stack engine is invoked (advanced).
# HERMES_BTS_COMMAND=bunx create-better-t-stack@latest
